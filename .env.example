# --- Core ---
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# --- Database ---
DATABASE_URL="postgresql://sprintguard:sprintguard@localhost:5432/sprintguard?schema=public"

# --- Redis / BullMQ ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=1h
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=30d

# --- Encryption (Credential Vault, Solution Architecture §18) ---
CREDENTIAL_ENCRYPTION_KEY=change-me-32-byte-base64-key

# --- Integration health-check sweep (internal, called by .github/workflows/integration-health-check.yml) ---
INTERNAL_CRON_SECRET=

# --- AI Providers (Solution Architecture §16.1) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Which provider AiOrchestrationService uses when a call doesn't specify one explicitly.
AI_DEFAULT_PROVIDER=anthropic

# --- Forgot-password email delivery (Resend) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Google Sign-In (Identity Services ID-token flow; no client secret needed) ---
GOOGLE_CLIENT_ID=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info

# --- Rate Limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100
