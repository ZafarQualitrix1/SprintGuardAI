// SprintGuard AI — Database Schema
// Implements docs/architecture/02-database-design.md
// Row-Level Security policies are applied separately via prisma/sql/rls_policies.sql
// (Prisma does not manage RLS or vector indexes natively).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector"), uuidOssp(map: "uuid-ossp")]
}

// ============================================================================
// Identity & Tenancy
// ============================================================================

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships            Membership[]
  apiKeys                ApiKey[]
  projects               Project[]
  agentRuns              AgentRun[]
  aiUsageMetrics         AiUsageMetric[]
  aiIncidents            AiIncident[]
  aiProviderConfigs      AiProviderConfig[]
  moduleAiConfigs        ModuleAiConfig[]
  knowledgeNodes         KnowledgeNode[]
  documentAssets         DocumentAsset[]
  integrationConnections IntegrationConnection[]
  featureFlagOverrides   FeatureFlagOverride[]
  pluginInstallations    PluginInstallation[]
  workflowDefinitions    WorkflowDefinition[]
  subscriptions          Subscription[]
  usageQuotas            UsageQuota[]
  tenantBranding         TenantBranding?
  auditLogs              AuditLog[]
  notifications          NotificationEvent[]
  organizationMemory     OrganizationMemory?
  organizationSettings   OrganizationSettings?
  invitations            Invitation[]

  @@index([slug])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  fullName     String
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  memberships         Membership[]
  refreshTokens       RefreshToken[]
  promptApprovals     PromptApproval[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  notifications       NotificationEvent[]
  passwordResetTokens PasswordResetToken[]

  @@index([email])
}

// Self-service "forgot password" flow. Mirrors Invitation's tokenHash pattern (only the hash is
// persisted; the raw token is emailed once and never stored). Short-lived (1h) relative to
// Invitation's 7 days since this guards an existing account, not an onboarding link.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id        String   @id @default(cuid())
  key       String   @unique // OWNER, ADMIN, PROJECT_ADMIN, QA_LEAD, QA_ENGINEER, PRODUCT_MANAGER, ENGINEER, VIEWER, PROMPT_APPROVER, PLATFORM_ADMIN
  name      String
  isSystem  Boolean  @default(true)
  createdAt DateTime @default(now())

  memberships     Membership[]
  rolePermissions RolePermission[]
  invitations     Invitation[]
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique // e.g. "sprint:read", "prompt:approve", "billing:manage"
  description String

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Membership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyPrefix      String
  hashedKey      String    @unique
  scopes         Json // string[]
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// Project & Sprint
// ============================================================================

model Project {
  id             String    @id @default(cuid())
  organizationId String
  key            String
  name           String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sprints              Sprint[]
  coverageMatrix       CoverageMatrixEntry[]
  gaps                 Gap[]
  releaseReports       ReleaseReport[]
  documentAssets       DocumentAsset[]
  projectMemory        ProjectMemory?
  releaseScoringConfig ReleaseScoringConfig?

  @@unique([organizationId, key])
  @@index([organizationId])
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SprintSource {
  MANUAL
  JIRA
  AZURE_DEVOPS
  GITHUB
  LINEAR
}

model Sprint {
  id                          String       @id @default(cuid())
  projectId                   String
  externalId                  String?
  name                        String
  goal                        String?
  status                      SprintStatus @default(PLANNED)
  source                      SprintSource @default(MANUAL)
  startDate                   DateTime?
  endDate                     DateTime?
  rawImport                   Json?
  // Jira connection this sprint was imported through, if any -- lets a story re-resolve live
  // Jira credentials for a deep re-fetch at analysis time. SetNull (not Cascade): deleting the
  // Jira connection must never take historical sprints/stories with it.
  sourceConnectionId          String?
  // Sync/lifecycle metadata. archivedAt/deletedAt are soft-state (same pattern as Organization/
  // Project), not enum values on SprintStatus, so archiving/deleting never collides with the
  // Jira-mirrored PLANNED/ACTIVE/COMPLETED/CANCELLED status.
  lastSyncedAt                DateTime?
  archivedAt                  DateTime?
  deletedAt                   DateTime?
  // Release Readiness mandatory gates (Rules 7/8): manually toggled until a full
  // Regression/Deployment-checklist module exists to derive these automatically.
  regressionCompleted         Boolean      @default(false)
  deploymentChecklistComplete Boolean      @default(false)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceConnection IntegrationConnection? @relation(fields: [sourceConnectionId], references: [id], onDelete: SetNull)
  stories          Story[]
  riskAssessments  RiskAssessment[]
  releaseReports   ReleaseReport[]
  coverageMatrix   CoverageMatrixEntry[]
  gaps             Gap[]
  executions       Execution[]
  sprintMemory     SprintMemory?
  syncEvents       SprintSyncEvent[]

  @@unique([projectId, externalId])
  @@index([projectId])
  @@index([projectId, status])
  @@index([sourceConnectionId])
}

enum SprintSyncAction {
  IMPORT
  SYNC
  OVERRIDE
  RENAME
  ARCHIVE
  UNARCHIVE
  DELETE
}

enum SprintSyncStatus {
  SUCCESS
  FAILED
}

// Audit trail backing both "View Import History" and "View Synchronization Logs" -- one event
// stream, since an import is just the first sync. Kept even if the sprint itself is later deleted
// is NOT required here (cascades with the sprint), unlike AuditLog which is org-level and durable.
model SprintSyncEvent {
  id             String           @id @default(cuid())
  sprintId       String
  organizationId String
  action         SprintSyncAction
  status         SprintSyncStatus @default(SUCCESS)
  storiesCreated Int              @default(0)
  storiesUpdated Int              @default(0)
  errorMessage   String?
  triggeredBy    String?
  createdAt      DateTime         @default(now())

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@index([sprintId, createdAt])
}

// ============================================================================
// Requirement Intelligence
// ============================================================================

enum StoryStatus {
  BACKLOG
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

model Story {
  id                          String       @id @default(cuid())
  sprintId                    String
  externalId                  String?
  title                       String
  description                 String?
  storyPoints                 Int?
  status                      StoryStatus  @default(BACKLOG)
  priority                    String?
  assignee                    String?
  source                      SprintSource @default(MANUAL)
  raw                         Json?
  // Smart Sprint Import (§2): issue-type/epic/label/component classification so import-by-epic/
  // label/assignee filters and the "User Stories / Tasks / Subtasks / Bugs" content checkboxes
  // have something structured to filter on, instead of only the free-form `raw` blob.
  issueType                   String       @default("Story") // Story | Task | Bug | Sub-task | Epic | ...
  epicKey                     String?
  epicName                    String?
  labels                      Json? // string[]
  components                  Json? // string[]
  parentStoryId               String? // Sub-task's parent issue, when imported as a distinct Story row
  assignedBaEmail             String? // Business Analyst assigned to review this story's AI-generated test cases
  assignedBaJiraAccountId     String? // resolved & cached Jira accountId for @mentions, cleared when assignedBaEmail changes
  assignedBaAccountResolvedAt DateTime?
  // Atomically incremented inside PrismaTestCaseRepository's replaceForScenario transaction to
  // mint each new TestCase's human-readable displayId ("{externalId ?? storyId}-TC-{n}").
  testCaseSequenceCounter     Int          @default(0)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  sprint                     Sprint                      @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  parentStory                Story?                      @relation("StorySubtasks", fields: [parentStoryId], references: [id], onDelete: SetNull)
  subtasks                   Story[]                     @relation("StorySubtasks")
  requirements               Requirement[]
  dependenciesFrom           Dependency[]                @relation("DependencyFrom")
  dependenciesTo             Dependency[]                @relation("DependencyTo")
  testScenarios              TestScenario[]
  riskAssessments            RiskAssessment[]
  defects                    Defect[]
  requirementAnalysisReports RequirementAnalysisReport[]
  baReviewState              StoryBaReviewState?

  @@unique([sprintId, externalId])
  @@index([sprintId])
  @@index([sprintId, status])
  @@index([parentStoryId])
}

// Deep, Groq-generated business-analyst/QA-architect report for a single story: risks, edge
// cases, API/DB/UI impact, enterprise test cases, self-assessed coverage. Deliberately separate
// from Requirement/AcceptanceCriterion (which stay normalized and feed the Coverage tab) --
// this is a versioned JSON snapshot per analysis run, not normalized rows.
model RequirementAnalysisReport {
  id                    String   @id @default(cuid())
  storyId               String
  sprintId              String
  organizationId        String
  aiProvider            String
  model                 String
  promptVersion         String
  version               Int      @default(1)
  isLatest              Boolean  @default(true)
  generatedBy           String?
  analysisJson          Json
  testCasesJson         Json
  coverageJson          Json
  confidenceScore       Float?
  generatedByAgentRunId String?
  jiraSnapshot          Json?
  createdAt             DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, isLatest])
  @@index([sprintId])
}

enum RequirementType {
  FUNCTIONAL
  NON_FUNCTIONAL
  BUSINESS_RULE
  CONSTRAINT
}

model Requirement {
  id                    String          @id @default(cuid())
  storyId               String
  text                  String
  type                  RequirementType @default(FUNCTIONAL)
  confidenceScore       Float?
  extractedByAgentRunId String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  story                 Story                 @relation(fields: [storyId], references: [id], onDelete: Cascade)
  acceptanceCriteria    AcceptanceCriterion[]
  coverageMatrixEntries CoverageMatrixEntry[]
  gaps                  Gap[]

  @@index([storyId])
}

model AcceptanceCriterion {
  id            String   @id @default(cuid())
  requirementId String
  given         String
  when          String
  then          String
  order         Int      @default(0)
  source        String   @default("AI_GENERATED") // AI_GENERATED | MANUAL
  createdAt     DateTime @default(now())

  requirement   Requirement    @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  testScenarios TestScenario[]

  @@index([requirementId])
}

enum DependencyType {
  BLOCKS
  RELATES_TO
  DUPLICATES
  SHARED_COMPONENT
}

model Dependency {
  id                   String         @id @default(cuid())
  fromStoryId          String
  toStoryId            String
  type                 DependencyType
  confidenceScore      Float?
  detectedByAgentRunId String?
  createdAt            DateTime       @default(now())

  fromStory Story @relation("DependencyFrom", fields: [fromStoryId], references: [id], onDelete: Cascade)
  toStory   Story @relation("DependencyTo", fields: [toStoryId], references: [id], onDelete: Cascade)

  @@index([fromStoryId])
  @@index([toStoryId])
}

// ============================================================================
// Test Intelligence
// ============================================================================

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model TestScenario {
  id                    String   @id @default(cuid())
  acceptanceCriterionId String
  storyId               String
  title                 String
  description           String?
  priority              Priority @default(MEDIUM)
  tags                  Json? // string[]
  generatedByAgentRunId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  acceptanceCriterion AcceptanceCriterion @relation(fields: [acceptanceCriterionId], references: [id], onDelete: Cascade)
  story               Story               @relation(fields: [storyId], references: [id], onDelete: Cascade)
  testCases           TestCase[]

  @@index([acceptanceCriterionId])
  @@index([storyId])
}

enum AutomationStatus {
  MANUAL
  AUTOMATABLE
  AUTOMATED
}

enum TestType {
  FUNCTIONAL
  NEGATIVE
  BOUNDARY
  VALIDATION
  BUSINESS_RULE
  API
  UI
  SECURITY
  PERFORMANCE
  ACCESSIBILITY
  DATABASE
  INTEGRATION
  REGRESSION
  SMOKE
  SANITY
}

enum AutomationType {
  NONE
  API
  UI
}

model TestCase {
  id                    String           @id @default(cuid())
  testScenarioId        String
  title                 String
  description           String?
  steps                 Json // { step: string, expected: string }[]
  testData              Json?
  priority              Priority         @default(MEDIUM)
  severity              Priority         @default(MEDIUM)
  module                String?
  testType              TestType         @default(FUNCTIONAL)
  tags                  Json? // string[]
  automationStatus      AutomationStatus @default(MANUAL)
  automationType        AutomationType   @default(NONE)
  apiEndpoint           String?
  uiScreen              String?
  generatedByAgentRunId String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  // Enterprise Test Generation fields (Solution Architecture BA Review Workflow enhancement).
  // displayId assigned once via Story.testCaseSequenceCounter (see Story model) so it stays stable
  // across regenerations/BA-review versions -- a Jira-attached V1 workbook and the live in-app
  // table must refer to the same test case by the same ID.
  displayId             String?          @unique // e.g. "PROJ-123-TC-7"
  testObjective         String?
  preconditions         Json? // string[]
  dependencies          String?
  requestMethod         String? // GET/POST/PUT/PATCH/DELETE, relevant when testType=API
  requestPayload        Json?
  expectedStatusCode    Int?
  expectedResponse      String?
  remarks               String?

  testScenario          TestScenario           @relation(fields: [testScenarioId], references: [id], onDelete: Cascade)
  executions            Execution[]
  coverageMatrix        CoverageMatrixEntry[]
  gaps                  Gap[]
  automationGenerations AutomationGeneration[]

  @@index([testScenarioId])
  @@index([automationType])
}

enum AutomationGenerationStatus {
  GENERATED
  SAVED
  COMMITTED
}

model AutomationGeneration {
  id                        String                     @id @default(cuid())
  testCaseId                String
  automationType            AutomationType // API | UI (never NONE here)
  version                   Int
  status                    AutomationGenerationStatus @default(GENERATED)
  frameworkVersion          String
  generatorVersion          String
  aiModelVersion            String
  files                     Json // { path: string, content: string }[]
  automationReadinessScore  Int?
  estimatedEffortHours      Float?
  complexityLevel           String? // LOW | MEDIUM | HIGH
  requiredPreconditions     Json? // string[]
  missingRequirementDetails Json? // string[]
  generatedByAgentRunId     String?
  createdBy                 String?
  createdAt                 DateTime                   @default(now())
  // API Automation (§Regenerate Automation): set true when the source test case is regenerated
  // after this automation was saved (e.g. admin-unlock -> BA-feedback-driven regeneration) -- the
  // generated code may no longer match the test case's steps/endpoint/payload. Never cleared
  // automatically; only a fresh GenerateAutomationCommand call (a new version) supersedes it.
  isOutdated                Boolean                    @default(false)

  testCase      TestCase                 @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  executionRuns AutomationExecutionRun[]

  @@unique([testCaseId, automationType, version])
  @@index([testCaseId, automationType])
}

// Automation Execution Module (§9/§10): a run is dispatched as a GitHub Actions workflow_dispatch
// (the same "GitHub Actions as automation backbone" pattern already used by deploy-uat.yml/
// db-migrate.yml in this repo) since the API itself runs on Vercel serverless, which cannot host a
// long-lived Playwright/browser process. The workflow POSTs its result back to a callback endpoint
// on completion; githubRunId/githubRunUrl let the UI deep-link to the live GitHub Actions log for
// anything this summary doesn't capture.
enum AutomationExecutionStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  ERROR
  CANCELLED
}

model AutomationExecutionRun {
  id                     String                    @id @default(cuid())
  organizationId         String
  storyId                String
  automationGenerationId String
  automationType         AutomationType
  environment            String
  browser                String? // chromium | firefox | webkit -- null for API-only runs
  tags                   Json? // string[]
  parallelWorkers        Int                       @default(1)
  status                 AutomationExecutionStatus @default(QUEUED)
  githubRunId            String?
  githubRunUrl           String?
  totalTests             Int?
  passedTests            Int?
  failedTests            Int?
  skippedTests           Int?
  testResultsJson        Json? // per-test summary: { title, status, durationMs, error? }[]
  logsText               String?
  errorMessage           String?
  reportArtifactUrl      String?
  startedAt              DateTime?
  completedAt            DateTime?
  triggeredBy            String
  createdAt              DateTime                  @default(now())

  automationGeneration AutomationGeneration @relation(fields: [automationGenerationId], references: [id], onDelete: Cascade)

  @@index([storyId])
  @@index([automationGenerationId])
  @@index([status])
}

// ============================================================================
// BA Review Workflow
// ============================================================================
// Mandatory Business-Analyst approval gate for AI-generated test cases, over Jira. TestCase/
// TestScenario rows themselves stay unversioned (see RunTestGenerationHandler) -- BaReviewCycle
// is the versioned, immutable audit trail (testCasesSnapshotJson) layered on top, and
// StoryBaReviewState is the single lock/status aggregate per story that RunTestGenerationHandler,
// RunRequirementIntelligenceAgentHandler, and RunDeepRequirementAnalysisHandler all check via
// IsStoryLockedQuery before allowing any AI regeneration.

enum BaReviewStatus {
  PENDING_REVIEW // cycle created, Jira comment/attachment not yet successfully posted
  AWAITING_APPROVAL // posted to Jira, waiting on BA reply
  FEEDBACK_RECEIVED // non-approval reply detected, regeneration not yet started
  REGENERATION_IN_PROGRESS // AI feedback-merge running
  APPROVED // terminal, locked
}

enum BaReviewApprovalStatus {
  PENDING // this cycle/version posted, awaiting reply
  FEEDBACK_RECEIVED // terminal for this cycle -- a new cycle (version+1) supersedes it
  APPROVED // terminal, this version is the baseline
}

enum BaReviewSyncAction {
  RESOLVE_BA_ACCOUNT
  POST_INITIAL_COMMENT
  UPLOAD_ATTACHMENT
  POLL_REPLIES
  POST_FOLLOWUP_COMMENT
  POST_MANUAL_SUBMISSION
}

enum BaReviewSyncStatus {
  SUCCESS
  FAILED
}

model StoryBaReviewState {
  id                   String         @id @default(cuid())
  storyId              String         @unique
  organizationId       String
  status               BaReviewStatus @default(PENDING_REVIEW)
  currentVersion       Int            @default(0)
  isLocked             Boolean        @default(false)
  activeReviewCycleId  String? // the one non-terminal BaReviewCycle for this story, if any
  lockedVersionId      String? // the BaReviewCycle that became the approved baseline
  reviewCycleCount     Int            @default(0)
  latestReviewerName   String? // Jira display name of the last replier
  latestReviewerUserId String? // best-effort match against User by email
  lastReviewAt         DateTime?
  lockedAt             DateTime?
  unlockedBy           String? // internal User.id (Admin)
  unlockedAt           DateTime?
  unlockReason         String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  story        Story           @relation(fields: [storyId], references: [id], onDelete: Cascade)
  reviewCycles BaReviewCycle[]

  @@index([organizationId, status])
}

model BaReviewCycle {
  id                              String                 @id @default(cuid())
  storyBaReviewStateId            String
  storyId                         String
  organizationId                  String
  version                         Int
  documentVersionLabel            String // "V1", "V2", ... == `V${version}`
  generatedBy                     String? // internal User.id who triggered generation; null if system-triggered
  generatedAt                     DateTime               @default(now())
  aiProvider                      String
  aiModelVersion                  String
  promptVersion                   String
  requirementAnalysisReportId     String? // input context used, if any
  testCasesSnapshotJson           Json // immutable [{scenario, testCases[]}] copy at this version
  distributionJson                Json // counts per TestType
  totalTestCases                  Int
  coveragePercent                 Float?
  automationReadinessPercent      Float?
  jiraIssueKey                    String // denormalized Story.externalId at post time
  jiraCommentId                   String?
  jiraAttachmentId                String?
  respondsToFeedbackFromVersionId String? // the previous cycle whose feedback triggered this version (null for V1)
  improvementSummaryJson          Json? // {feedbackSummary, added[], modified[], removedReasons, coverageImpact, automationReadinessImpact, traceabilityImpact}
  feedbackText                    String? // BA's raw reply that ended THIS cycle
  feedbackAuthor                  String?
  feedbackJiraCommentId           String? // idempotency marker: last comment id already processed for this cycle
  feedbackReceivedAt              DateTime?
  approvalStatus                  BaReviewApprovalStatus @default(PENDING)
  approvedBy                      String? // Jira display name
  approvedByUserId                String? // best-effort internal User.id match
  approvalComment                 String? // literal reply text that satisfied the keyword match
  approvedAt                      DateTime?
  createdAt                       DateTime               @default(now())
  updatedAt                       DateTime               @updatedAt

  storyBaReviewState StoryBaReviewState @relation(fields: [storyBaReviewStateId], references: [id], onDelete: Cascade)

  @@unique([storyId, version])
  @@index([storyId, approvalStatus])
  @@index([organizationId])
}

model BaReviewSyncLog {
  id             String             @id @default(cuid())
  storyId        String
  organizationId String
  reviewCycleId  String?
  action         BaReviewSyncAction
  status         BaReviewSyncStatus @default(SUCCESS)
  attempt        Int                @default(1)
  errorMessage   String?
  createdAt      DateTime           @default(now())

  @@index([storyId, createdAt])
  @@index([organizationId, status])
}

// Real Jira comment-thread mirror: every comment SyncBaReviewThreadsCommand has ever seen on the
// issue, not just the one newest reply it acts on -- a full audit-grade record of the conversation,
// additive to BaReviewCycle's per-version rollup. Idempotent per (storyId, jiraCommentId) so re-polling
// the same comment is a no-op update, not a duplicate row. No FK relation to Story, matching
// BaReviewSyncLog's existing denormalized-id convention for this module's per-event tables.
model BaReviewJiraComment {
  id                  String    @id @default(cuid())
  storyId             String
  organizationId      String
  jiraCommentId       String
  authorDisplayName   String?
  authorAccountId     String?
  authorAvatarUrl     String?
  bodyAdf             Json?
  bodyText            String
  mentionedAccountIds Json? // string[]
  attachmentFilenames Json? // string[]
  isOwnComment        Boolean   @default(false) // posted by SprintGuard AI itself, not a genuine BA reply
  classifiedAs        String? // 'APPROVAL' | 'FEEDBACK' -- set only on the one comment ProcessBaReplyCommand actually acted on
  jiraCreatedAt       DateTime?
  createdAt           DateTime  @default(now())

  @@unique([storyId, jiraCommentId])
  @@index([organizationId])
  @@index([storyId, jiraCreatedAt])
}

// ============================================================================
// Coverage & Risk
// ============================================================================

enum CoverageStatus {
  COVERED
  PARTIALLY_COVERED
  NOT_COVERED
}

model CoverageMatrixEntry {
  id             String         @id @default(cuid())
  projectId      String
  sprintId       String
  requirementId  String
  testCaseId     String?
  coverageStatus CoverageStatus @default(NOT_COVERED)
  computedAt     DateTime       @default(now())

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint      Sprint      @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  testCase    TestCase?   @relation(fields: [testCaseId], references: [id])

  @@unique([sprintId, requirementId])
  @@index([projectId, sprintId])
  @@index([requirementId])
}

enum GapSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Gap {
  id            String      @id @default(cuid())
  projectId     String
  sprintId      String
  requirementId String?
  testCaseId    String?
  gapType       String // MISSING_TEST | MISSING_AC | STALE_COVERAGE
  severity      GapSeverity @default(MEDIUM)
  description   String
  resolvedAt    DateTime?
  createdAt     DateTime    @default(now())

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint      Sprint       @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  requirement Requirement? @relation(fields: [requirementId], references: [id])
  testCase    TestCase?    @relation(fields: [testCaseId], references: [id])

  @@unique([sprintId, requirementId])
  @@index([projectId, sprintId])
}

model RiskAssessment {
  id                    String   @id @default(cuid())
  sprintId              String
  storyId               String?
  riskScore             Float
  riskFactors           Json // structured factor breakdown
  generatedByAgentRunId String?
  createdAt             DateTime @default(now())

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  story  Story? @relation(fields: [storyId], references: [id])

  @@index([sprintId])
}

// ============================================================================
// Execution
// ============================================================================

enum ExecutionStatus {
  NOT_RUN
  PASSED
  FAILED
  BLOCKED
  SKIPPED
}

model Execution {
  id                  String          @id @default(cuid())
  testCaseId          String
  sprintId            String
  status              ExecutionStatus @default(NOT_RUN)
  executedBy          String?
  executedAt          DateTime?
  notes               String?
  evidenceUrl         String?
  createdAt           DateTime        @default(now())
  // Manual Execution Module (§8) rich capture fields.
  actualResult        String?
  attachmentUrls      Json? // string[]
  screenshotUrls      Json? // string[]
  defectReference     String? // free-text ticket/bug reference, not a relational FK
  executionDurationMs Int?
  testerName          String?

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  sprint   Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  defects  Defect[]

  @@index([testCaseId])
  @@index([sprintId])
}

// ============================================================================
// Release Governance
// ============================================================================

enum ReleaseReportStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
}

model ReleaseReport {
  id                    String              @id @default(cuid())
  projectId             String
  sprintId              String
  readinessScore        Float
  executiveSummary      String?
  breakdown             Json // per-dimension score breakdown
  status                ReleaseReportStatus @default(DRAFT)
  generatedByAgentRunId String?
  createdAt             DateTime            @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint  Sprint  @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@index([projectId, sprintId])
}

// Configurable AI Release Readiness scoring engine (weights + severity deduction table) -- one
// row per project, falling back to the documented defaults when absent. Weights are expected to
// sum to 100 but that's enforced at the application layer, not the DB, so partial/experimental
// configs never corrupt the table.
model ReleaseScoringConfig {
  id                              String   @id @default(cuid())
  projectId                       String   @unique
  requirementCoverageWeight       Float    @default(20)
  testCaseCoverageWeight          Float    @default(15)
  manualExecutionWeight           Float    @default(20)
  automationExecutionWeight       Float    @default(20)
  bugRiskWeight                   Float    @default(25)
  // Per-severity point deduction applied to the bug-risk component for each open defect of that
  // severity, e.g. { "BLOCKER": -100, "CRITICAL": -40, "HIGH": -20, "MAJOR": -10, "MEDIUM": -5,
  // "MINOR": -2, "TRIVIAL": -1 }.
  severityDeductions              Json
  manualPassRateBlockThreshold    Float    @default(90)
  automationCoverageWarnThreshold Float    @default(70)
  updatedAt                       DateTime @updatedAt
  createdAt                       DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ============================================================================
// Defect Intelligence (Phase 2 — schema defined now)
// ============================================================================

// 7-level severity model (AI Release Readiness Algorithm's bug-risk deduction table). Replaces
// the earlier LOW/MEDIUM/HIGH/CRITICAL set -- BLOCKER/MAJOR/MINOR/TRIVIAL added, LOW retired
// (existing LOW rows are backfilled to MINOR by the migration that introduced this).
enum DefectSeverity {
  BLOCKER
  CRITICAL
  HIGH
  MAJOR
  MEDIUM
  MINOR
  TRIVIAL
}

enum DefectStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  WONT_FIX
}

model Defect {
  id          String         @id @default(cuid())
  storyId     String?
  executionId String?
  externalId  String?
  title       String
  severity    DefectSeverity @default(MEDIUM)
  status      DefectStatus   @default(OPEN)
  source      SprintSource   @default(MANUAL)
  createdAt   DateTime       @default(now())

  story     Story?     @relation(fields: [storyId], references: [id])
  execution Execution? @relation(fields: [executionId], references: [id])

  @@index([storyId])
}

// ============================================================================
// Agent Framework
// ============================================================================

enum AgentStatus {
  REGISTERED
  ENABLED
  DEPRECATED
  DISABLED
}

model Agent {
  id           String      @id @default(cuid())
  key          String      @unique // e.g. "sprint-analyst", "test-scenario-generator"
  name         String
  description  String?
  version      String
  capabilities Json // string[] capability tags (Agent Capability Registry)
  status       AgentStatus @default(REGISTERED)
  isBuiltIn    Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  runs         AgentRun[]
  toolBindings AgentToolBinding[]
  usageMetrics AiUsageMetric[]
}

enum AgentRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  RETRYING
  FLAGGED_FOR_REVIEW
}

model AgentRun {
  id              String         @id @default(cuid())
  agentId         String
  organizationId  String
  correlationId   String
  parentRunId     String?
  status          AgentRunStatus @default(PENDING)
  input           Json
  output          Json?
  confidenceScore Float?
  provider        String?
  model           String?
  tokensUsed      Int?
  costUsd         Decimal?       @db.Decimal(10, 6)
  error           String?
  // Observability (attempts consumed beyond the first before this run reached its final status --
  // 0 means it succeeded/failed on the first attempt). Nullable: rows created before this column
  // existed have no recorded value, not a real "zero retries" fact.
  retryCount      Int?
  // Free-form, not a DB enum, so new classifications (e.g. Phase 3's auth/config/rate_limit/
  // transient split) don't need a migration to add a value. Application-layer union type is
  // ValidationStatus in agent-run.repository.interface.ts. One of: PASSED_FIRST_TRY,
  // PASSED_AFTER_REPAIR, FAILED_VALIDATION, FAILED_PROVIDER_ERROR.
  validationStatus String?
  startedAt       DateTime       @default(now())
  completedAt     DateTime?

  agent          Agent             @relation(fields: [agentId], references: [id])
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       AgentMessage[]
  aiResponses    AiResponse[]
  decisionAudits AiDecisionAudit[]

  @@index([organizationId, status])
  @@index([correlationId])
}

model AgentMessage {
  id         String   @id @default(cuid())
  agentRunId String
  fromAgent  String
  toAgent    String
  intent     String
  payload    Json
  createdAt  DateTime @default(now())

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId])
}

model AgentTool {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "QueryKnowledgeGraphTool"
  name        String
  description String?
  schema      Json // JSON Schema of tool input/output

  bindings AgentToolBinding[]
}

model AgentToolBinding {
  agentId String
  toolId  String

  agent Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool  AgentTool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([agentId, toolId])
}

// ============================================================================
// AI Orchestration / Governance
// ============================================================================

enum PromptStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ACTIVE
  DEPRECATED
}

model AiPrompt {
  id            String       @id @default(cuid())
  capability    String // e.g. "test-scenario-generation"
  version       String
  template      String
  jsonSchema    Json
  model         String?
  status        PromptStatus @default(DRAFT)
  isActive      Boolean      @default(false)
  templateHash  String
  createdBy     String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  // Prompt Management (admin-facing) fields -- deliberately nullable since the 6 seed-created
  // prompts predate this module; backfilled lazily on first edit, not required for the runtime
  // execution path (AiOrchestrationService never reads these).
  name          String?
  description   String?
  category      String?
  tags          Json? // string[]
  changeSummary String? // what changed in this version vs. the previous one

  approvals   PromptApproval[]
  aiResponses AiResponse[]

  @@unique([capability, version])
  @@index([capability, isActive])
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

model PromptApproval {
  id          String           @id @default(cuid())
  promptId    String
  reviewerId  String
  decision    ApprovalDecision
  rationale   String?
  diffSummary String?
  createdAt   DateTime         @default(now())

  prompt   AiPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  reviewer User     @relation(fields: [reviewerId], references: [id])

  @@index([promptId])
}

model ModelRegistryEntry {
  id                  String   @id @default(cuid())
  provider            String // anthropic | openai | google
  model               String
  version             String?
  allowedCapabilities Json // string[]
  costTier            String // cheap | standard | reasoning
  isActive            Boolean  @default(true)
  orgAllowList        Json? // null = all orgs; else organizationId[]
  createdAt           DateTime @default(now())

  aiResponses AiResponse[]

  @@unique([provider, model])
}

model GuardrailPolicy {
  id        String   @id @default(cuid())
  name      String
  type      String // pii | content-safety | schema
  config    Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AiResponse {
  id                   String   @id @default(cuid())
  agentRunId           String
  promptId             String
  modelRegistryEntryId String?
  promptVersion        String
  promptHash           String
  rawResponse          Json
  parsedResponse       Json
  confidenceScore      Float
  tokensUsed           Int?
  // Split out of tokensUsed (which stays as the sum, for existing cost-estimation consumers) --
  // the provider response already returns these separately; previously discarded before persistence.
  inputTokens          Int?
  outputTokens         Int?
  costUsd              Decimal? @db.Decimal(10, 6)
  latencyMs            Int?
  createdAt            DateTime @default(now())

  agentRun           AgentRun            @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  prompt             AiPrompt            @relation(fields: [promptId], references: [id])
  modelRegistryEntry ModelRegistryEntry? @relation(fields: [modelRegistryEntryId], references: [id])
  decisionAudits     AiDecisionAudit[]

  @@index([agentRunId])
  @@index([promptId])
}

model AiDecisionAudit {
  id           String   @id @default(cuid())
  agentRunId   String
  aiResponseId String?
  decisionType String // e.g. "human-approval", "guardrail-block", "rollback"
  outcome      String
  reviewerId   String?
  rationale    String?
  createdAt    DateTime @default(now())

  agentRun   AgentRun    @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  aiResponse AiResponse? @relation(fields: [aiResponseId], references: [id])

  @@index([agentRunId])
}

// ============================================================================
// AI Operations
// ============================================================================

model AiUsageMetric {
  id             String   @id @default(cuid())
  organizationId String
  agentId        String?
  provider       String
  model          String
  date           DateTime @db.Date
  tokensUsed     Int      @default(0)
  costUsd        Decimal  @default(0) @db.Decimal(10, 6)
  requestCount   Int      @default(0)
  errorCount     Int      @default(0)
  avgLatencyMs   Int?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent?       @relation(fields: [agentId], references: [id])

  @@unique([organizationId, agentId, provider, model, date])
  @@index([organizationId, date])
}

enum AiIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model AiIncident {
  id             String             @id @default(cuid())
  organizationId String
  agentId        String?
  type           String // hallucination | provider-outage | guardrail-violation
  severity       AiIncidentSeverity @default(MEDIUM)
  description    String
  resolvedAt     DateTime?
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, resolvedAt])
}

model Benchmark {
  id            String   @id @default(cuid())
  capability    String
  promptVersion String
  provider      String
  model         String
  datasetName   String
  metrics       Json // precision/recall/acceptance-style metrics
  runAt         DateTime @default(now())

  @@index([capability, promptVersion])
}

// AI Settings Control Center (Solution Architecture §16.1 extension). Org-scoped, mirrors the
// Integration Hub's IntegrationConnection credential-storage pattern (AES-256-GCM via the shared
// CredentialVault) rather than the env-var-only provider config used before this.
model AiProviderConfig {
  id                String       @id @default(cuid())
  organizationId    String
  provider          String // google | openai | anthropic | deepseek | groq | ollama | openrouter
  isEnabled         Boolean      @default(false)
  isDefault         Boolean      @default(false)
  apiKeyEncrypted   String? // AES-256-GCM envelope blob; null until an admin configures a key
  defaultModel      String?
  projectId         String?
  region            String?
  timeoutMs         Int?         @default(30000)
  retryCount        Int?         @default(2)
  temperature       Float?       @default(0.7)
  topP              Float?
  topK              Int?
  maxOutputTokens   Int?
  streaming         Boolean      @default(false)
  safetySettings    Json?
  fallbackProvider  String?
  fallbackModel     String?
  healthStatus      HealthStatus @default(UNKNOWN)
  lastConnectedAt   DateTime?
  lastTestLatencyMs Int?
  lastTestError     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

// Per-capability override of provider/model/parameters, resolved by AiOrchestrationService before
// every execute() call. Absent row (or isEnabled: false) falls back to the org's default provider.
model ModuleAiConfig {
  id               String   @id @default(cuid())
  organizationId   String
  capability       String // requirement-intelligence | test-scenario | test-case | coverage-recommendation | release-readiness-summary
  isEnabled        Boolean  @default(true)
  provider         String?
  model            String?
  temperature      Float?
  maxTokens        Int?
  retryCount       Int?
  timeoutMs        Int?
  streaming        Boolean?
  fallbackProvider String?
  fallbackModel    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, capability])
}

// ============================================================================
// AI Memory
// ============================================================================

model SprintMemory {
  sprintId  String   @id
  facts     Json
  updatedAt DateTime @updatedAt

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
}

model ProjectMemory {
  projectId String   @id
  facts     Json
  summary   String?
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model OrganizationMemory {
  organizationId String   @id
  preferences    Json
  calibration    Json?
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ConversationMemory {
  id         String    @id @default(cuid())
  sessionId  String    @unique
  userId     String?
  messages   Json // archived transcript
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  @@index([sessionId])
}

// ============================================================================
// Knowledge Intelligence
// ============================================================================

model KnowledgeNode {
  id             String                       @id @default(cuid())
  organizationId String
  entityType     String // Story | Requirement | AcceptanceCriterion | TestCase | Defect | Release | DocumentChunk
  entityId       String
  embedding      Unsupported("vector(1536)")?
  metadata       Json?
  createdAt      DateTime                     @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  edgesFrom    KnowledgeEdge[] @relation("EdgeFrom")
  edgesTo      KnowledgeEdge[] @relation("EdgeTo")

  @@unique([organizationId, entityType, entityId])
  @@index([organizationId, entityType])
}

model KnowledgeEdge {
  id             String   @id @default(cuid())
  organizationId String
  fromNodeId     String
  toNodeId       String
  relationType   String // DERIVED_FROM | TESTED_BY | DEPENDS_ON | CAUSED_BY | PART_OF | AFFECTS
  weight         Float    @default(1.0)
  metadata       Json?
  createdAt      DateTime @default(now())

  fromNode KnowledgeNode @relation("EdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode   KnowledgeNode @relation("EdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@index([organizationId, relationType])
  @@index([fromNodeId])
  @@index([toNodeId])
}

// ============================================================================
// Document Intelligence
// ============================================================================

enum DocumentStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

model DocumentAsset {
  id             String         @id @default(cuid())
  organizationId String
  projectId      String?
  fileName       String
  mimeType       String
  sourceSystem   String? // confluence | notion | upload
  storageUrl     String
  status         DocumentStatus @default(UPLOADED)
  language       String?
  piiDetected    Boolean        @default(false)
  uploadedBy     String
  createdAt      DateTime       @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?        @relation(fields: [projectId], references: [id])
  chunks       DocumentChunk[]

  @@index([organizationId])
}

model DocumentChunk {
  id              String                       @id @default(cuid())
  documentAssetId String
  chunkIndex      Int
  content         String
  embedding       Unsupported("vector(1536)")?
  metadata        Json?

  documentAsset DocumentAsset @relation(fields: [documentAssetId], references: [id], onDelete: Cascade)

  @@index([documentAssetId])
}

// ============================================================================
// Integration Hub
// ============================================================================

model Connector {
  id           String  @id @default(cuid())
  key          String  @unique // jira | azure-devops | github | gitlab | linear | slack | teams | confluence | notion | testrail | xray | zephyr | azure-test-plans
  name         String
  isBuiltIn    Boolean @default(true)
  configSchema Json

  connections IntegrationConnection[]
}

enum ConnectionStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED
}

// Distinct from ConnectionStatus (which tracks the connection's lifecycle/auth state):
// HealthStatus tracks the outcome of the most recent liveness check (manual "Test Connection"
// or the internal health-check sweep), independent of whether the connection is currently
// CONNECTED/ERROR/DISCONNECTED.
enum HealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
  UNKNOWN
}

model IntegrationConnection {
  id                   String           @id @default(cuid())
  organizationId       String
  connectorId          String
  name                 String
  siteUrl              String // denormalized from config.siteUrl for display/dedup without decrypting
  email                String? // denormalized display copy of the connected account's email, NOT the secret --
  // nullable because pre-existing rows (connected before this column existed) have no plaintext
  // source to backfill it from (only credentialsEncrypted has it, inside the encrypted blob);
  // always populated for connections created after this migration.
  credentialsEncrypted String // AES-256-GCM envelope-encrypted blob
  status               ConnectionStatus @default(PENDING)
  isDefault            Boolean          @default(false)
  healthStatus         HealthStatus     @default(UNKNOWN)
  lastHealthCheckAt    DateTime?
  lastSyncedAt         DateTime?
  config               Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connector     Connector            @relation(fields: [connectorId], references: [id])
  webhookEvents WebhookEvent[]
  syncJobs      SyncJob[]
  projects      IntegrationProject[]
  sprints       Sprint[]

  // Prevents the same org from connecting the same Jira site under the same account twice.
  // Legacy rows with email=NULL are exempt from this (Postgres treats NULL as distinct in
  // unique indexes), which is fine -- true duplicate-prevention only matters going forward.
  @@unique([organizationId, connectorId, siteUrl, email])
  @@index([organizationId])
}

// Cache of the Jira (or future connector) projects a connection can see -- populated by the
// import wizard's "load projects" step and by "Sync Now", never authoritative. The real
// imported-sprint data lives in the sprint module's own Project/Sprint/Story models, which this
// table is never joined against.
model IntegrationProject {
  id           String   @id @default(cuid())
  connectionId String
  externalKey  String
  name         String
  avatarUrl    String?
  lead         String?
  isArchived   Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalKey])
  @@index([connectionId])
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  DUPLICATE
}

model WebhookEvent {
  id           String             @id @default(cuid())
  connectionId String
  externalId   String
  eventType    String
  payload      Json
  status       WebhookEventStatus @default(RECEIVED)
  processedAt  DateTime?
  createdAt    DateTime           @default(now())

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([connectionId, status])
}

enum SyncDirection {
  INBOUND
  OUTBOUND
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model SyncJob {
  id           String        @id @default(cuid())
  connectionId String
  direction    SyncDirection
  status       SyncJobStatus @default(QUEUED)
  cursor       String?
  error        String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime      @default(now())

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, status])
}

// ============================================================================
// Feature Management
// ============================================================================

model FeatureFlag {
  id           String   @id @default(cuid())
  key          String   @unique
  description  String?
  defaultValue Json
  isBeta       Boolean  @default(false)
  createdAt    DateTime @default(now())

  overrides   FeatureFlagOverride[]
  experiments Experiment[]
}

model FeatureFlagOverride {
  id                String   @id @default(cuid())
  flagId            String
  organizationId    String?
  userId            String?
  value             Json
  rolloutPercentage Int      @default(100)
  createdAt         DateTime @default(now())

  flag         FeatureFlag   @relation(fields: [flagId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([flagId, organizationId])
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  COMPLETED
}

model Experiment {
  id        String           @id @default(cuid())
  flagId    String
  name      String
  variants  Json // [{ key, weight }]
  metric    String
  status    ExperimentStatus @default(DRAFT)
  startedAt DateTime?
  endedAt   DateTime?

  flag FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([flagId])
}

// ============================================================================
// Plugin Framework
// ============================================================================

enum PluginType {
  AI_PROVIDER
  INTEGRATION
  PROMPT
  AGENT
  WORKFLOW_NODE
}

model Plugin {
  id        String     @id @default(cuid())
  key       String     @unique
  name      String
  type      PluginType
  version   String
  isBuiltIn Boolean    @default(true)
  manifest  Json
  createdAt DateTime   @default(now())

  installations PluginInstallation[]
}

model PluginInstallation {
  id             String   @id @default(cuid())
  pluginId       String
  organizationId String
  isEnabled      Boolean  @default(true)
  config         Json?
  createdAt      DateTime @default(now())

  plugin       Plugin       @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([pluginId, organizationId])
}

// ============================================================================
// Workflow Engine
// ============================================================================

enum WorkflowDefinitionStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  DEPRECATED
}

model WorkflowDefinition {
  id             String                   @id @default(cuid())
  organizationId String
  name           String
  version        String
  graph          Json // serialized node/edge graph
  status         WorkflowDefinitionStatus @default(DRAFT)
  isActive       Boolean                  @default(false)
  createdBy      String
  createdAt      DateTime                 @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         WorkflowRun[]

  @@unique([organizationId, name, version])
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model WorkflowRun {
  id                   String            @id @default(cuid())
  workflowDefinitionId String
  status               WorkflowRunStatus @default(PENDING)
  input                Json
  output               Json?
  startedAt            DateTime          @default(now())
  completedAt          DateTime?

  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)

  @@index([workflowDefinitionId])
}

// ============================================================================
// Realtime & Notification
// ============================================================================

enum NotificationChannel {
  IN_APP
  SLACK
  TEAMS
  EMAIL
}

model NotificationEvent {
  id             String              @id @default(cuid())
  organizationId String
  userId         String?
  type           String
  title          String
  body           String?
  payload        Json?
  channel        NotificationChannel @default(IN_APP)
  readAt         DateTime?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, userId, readAt])
}

// ============================================================================
// SaaS Platform
// ============================================================================

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Subscription {
  id                        String             @id @default(cuid())
  organizationId            String
  plan                      String // starter | growth | enterprise
  status                    SubscriptionStatus @default(TRIALING)
  seats                     Int                @default(5)
  billingProviderCustomerId String?
  billingProviderSubId      String?
  currentPeriodEnd          DateTime?
  createdAt                 DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model UsageQuota {
  id             String   @id @default(cuid())
  organizationId String
  metric         String // ai_tokens | integration_connections | seats
  limit          Int
  used           Int      @default(0)
  periodStart    DateTime
  periodEnd      DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric, periodStart])
}

model TenantBranding {
  organizationId String  @id
  logoUrl        String?
  primaryColor   String?
  customDomain   String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Organization Settings module: single settings row per org (Solution Architecture extension).
// Deliberately one wide table rather than split models -- every field here is a simple scalar
// config value edited together from one settings page, not an independently-queried aggregate.
model OrganizationSettings {
  id             String @id @default(cuid())
  organizationId String @unique

  // Organization Profile
  domain             String?
  timezone           String  @default("UTC")
  defaultLanguage    String  @default("en")
  currency           String  @default("USD")
  dateFormat         String  @default("YYYY-MM-DD")
  workingDays        Json? // string[], e.g. ["MON",...,"FRI"] -- defaulted at the application layer
  businessHoursStart String? @default("09:00")
  businessHoursEnd   String? @default("18:00")

  // Workspace Configuration
  defaultProjectId          String?
  defaultSprintDurationDays Int?    @default(14)
  storyPointScale           Json? // number[], e.g. [1,2,3,5,8,13] -- defaulted at the application layer
  autoSaveIntervalSeconds   Int?    @default(30)

  // Jira Integration Settings (captured preferences -- sync-pipeline enforcement is follow-up)
  importSprintsEnabled      Boolean @default(true)
  importUserStoriesEnabled  Boolean @default(true)
  importBugsEnabled         Boolean @default(true)
  importTestEvidenceEnabled Boolean @default(false)
  jiraAutoSyncEnabled       Boolean @default(false)

  // Notification Settings
  notifyEmail            Boolean @default(false)
  notifySlack            Boolean @default(false)
  notifyTeams            Boolean @default(false)
  notifyBrowser          Boolean @default(true)
  notifyRelease          Boolean @default(true)
  notifySprintCompletion Boolean @default(true)
  notifyBug              Boolean @default(true)
  notifyAiGeneration     Boolean @default(true)
  notifyBaApproval       Boolean @default(true)
  slackWebhookEncrypted  String? // AES-256-GCM envelope
  teamsWebhookEncrypted  String? // AES-256-GCM envelope

  // Security Settings (2FA / per-device sessions deferred -- see plan)
  sessionTimeoutMinutes    Int?    @default(60)
  passwordMinLength        Int?    @default(10)
  passwordRequireUppercase Boolean @default(true)
  passwordRequireNumber    Boolean @default(true)
  passwordRequireSymbol    Boolean @default(false)
  allowedDomains           Json? // string[]
  allowedIpRanges          Json? // string[]

  // Automation Defaults
  automationFramework            String? @default("playwright")
  automationBrowser              String? @default("chromium")
  automationHeadless             Boolean @default(true)
  automationParallelExecution    Boolean @default(false)
  automationRetryCount           Int?    @default(1)
  automationReportFormat         String? @default("html")
  automationScreenshotPolicy     String? @default("on-failure")
  automationVideoPolicy          String? @default("off")
  automationExecutionEnvironment String? @default("local")

  // AI Organization Configuration (provider/model defaults + budget live in AiProviderConfig/
  // UsageQuota, already built by the AI Settings module -- these are the org-wide toggles only)
  aiPromptApprovalRequired Boolean @default(false)
  aiLoggingEnabled         Boolean @default(true)
  aiAuditTrailEnabled      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// No email delivery exists in this codebase yet -- the invite flow generates a shareable link
// (tokenHash stored, raw token only ever returned once in the invite response) that the admin
// copies and sends manually, same honest workaround as ResetUserPasswordCommand.
model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  roleId         String
  tokenHash      String           @unique
  invitedBy      String
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@index([organizationId, status])
}

// ============================================================================
// Platform / Audit
// ============================================================================

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String // e.g. "prompt.promoted", "sprint.imported", "user.invited"
  targetType     String
  targetId       String
  before         Json?
  after          Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
  @@index([targetType, targetId])
}

// ============================================================================
// Transactional Outbox (Event-Driven reliability, Solution Architecture §9.2)
// ============================================================================

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model OutboxMessage {
  id          String       @id @default(cuid())
  eventType   String
  payload     Json
  status      OutboxStatus @default(PENDING)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())

  @@index([status, createdAt])
}
