# --- API ---
# Points the web app at its backend. Set per Vercel project/environment -- never hardcode:
#   sprintguardai_uat  -> https://sprintguardai-api-uat.vercel.app/api/v1
#   sprintguardai_prod -> https://sprintguardai-api-prod.vercel.app/api/v1 (or the prod custom domain)
NEXT_PUBLIC_API_URL=

# --- Realtime (Release Readiness WebSocket push) ---
# Points at the persistent worker process (apps/api/src/worker.ts), NOT the serverless API --
# see apps/api/src/worker.ts for why the two are split. Falls back to http://localhost:3002 in
# local dev if unset.
NEXT_PUBLIC_REALTIME_URL=

# --- Google Sign-In ---
# Public value (safe to expose to the browser). Must match apps/api's GOOGLE_CLIENT_ID.
# Authorized JavaScript origins for this OAuth client must include this app's URL.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=http://localhost:3001/api/v1
