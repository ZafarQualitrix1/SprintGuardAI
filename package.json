{
  "name": "sprintguard-ai",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @sprintguard/database exec prisma generate",
    "db:migrate": "pnpm --filter @sprintguard/database exec prisma migrate dev",
    "db:deploy": "pnpm --filter @sprintguard/database exec prisma migrate deploy",
    "db:seed": "pnpm --filter @sprintguard/database exec prisma db seed",
    "db:studio": "pnpm --filter @sprintguard/database exec prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "prettier": "^3.3.0"
  }
}
